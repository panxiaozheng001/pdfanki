{
  "name": "pdfanki",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo build --output-logs=errors-only && oxlint --type-aware --deny-warnings",
    "test": "turbo test",
    "test:coverage": "turbo test:coverage",
    "test:live:codex": "pnpm build && pnpm --dir cli test:live:codex",
    "typecheck": "turbo typecheck",
    "clean": "turbo clean",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "fetch-config-prompts": "./scripts/fetch-config-prompts",
    "cli-local-test": "./scripts/cli-local-test",
    "pdfanki-local": "env PDFANKI_LOCAL_DEV=1 PDFANKI_CALLER_CWD=\"$INIT_CWD\" pnpm --dir cli exec node --import tsx src/index.ts"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "lefthook": "^2.1.10",
    "oxfmt": "^0.64.0",
    "oxlint": "^1.79.0",
    "oxlint-tsgolint": "^7.0.2001",
    "turbo": "^2.10.7",
    "typescript": "^7.0.2"
  },
  "packageManager": "pnpm@11.18.0+sha512.33d83c77da82f49fba836925c6f1b841181ec3132b670639bd012f7075f5c7cf634c5f870147c19aae7478fac01df09d8892e880454896edd23ee9b33757563c"
}
